{
  "entities": {
    "Penia": {
      "title": "Peña",
      "description": "Un grupo o colectivo de usuarios que comparten boletos, chat y alertas.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "gameId": { "type": "string" },
        "creator": { "type": "string" },
        "creatorUid": { "type": "string" },
        "createdAt": { "type": "string" },
        "members": { "type": "array" },
        "memberUids": { "type": "array" },
        "tickets": { "type": "array" },
        "messages": { "type": "array" },
        "alerts": { "type": "array" },
        "totalPrizes": { "type": "number" }
      },
      "required": ["code", "name", "gameId", "creator", "members"]
    }
  },
  "firestore": {
    "/penias/{peniaId}": {
      "schema": "Penia",
      "description": "Colección de peñas compartidas entre miembros."
    }
  }
}
