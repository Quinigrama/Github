rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net - default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Rules for Penias collection
    match /penias/{peniaId} {
      // Allow read for any authenticated user (including anonymous auth)
      allow read: if request.auth != null;

      // Allow create for authenticated users if creatorUid matches request.auth.uid
      allow create: if request.auth != null
        && request.resource.data.code is string
        && request.resource.data.name is string
        && request.resource.data.creator is string
        && request.resource.data.creatorUid is string
        && request.resource.data.creatorUid == request.auth.uid;

      // Allow update only for the creator
      allow update: if request.auth != null
        && resource.data.creatorUid == request.auth.uid;

      // Allow delete only for the creator
      allow delete: if request.auth != null
        && resource.data.creatorUid == request.auth.uid;
    }
  }
}
